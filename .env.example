# Neon Postgres connection string
# Get it from: https://neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin dashboard password
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Random secret for signing admin session cookies
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-secret"

# Vercel Blob storage (for admin image uploads)
# Create a store at: https://vercel.com → your project → Storage → Create Blob store
# Then connect it to the project — Vercel sets this token automatically.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
